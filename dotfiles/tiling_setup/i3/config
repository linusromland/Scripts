# i3 main config

include ~/.config/tiling_setup/common/variables
include ~/.config/tiling_setup/common/keybindings
include ~/.config/tiling_setup/common/layout
include ~/.config/tiling_setup/common/resize
include ~/.config/tiling_setup/common/styling

include ~/.config/tiling_setup/i3/output
include ~/.config/tiling_setup/i3/i3-specific.conf

# i3-specific launcher
set $menu rofi -show drun
set $lock i3lock -c 000000

# Notifications
exec --no-startup-id dunst

# Status bar
bar {
    position top
    status_command ~/.config/tiling_setup/common/status.sh
    font pango:JetBrainsMono Nerd Font 12
}

# Load monitor config based on host
exec --no-startup-id ~/.config/i3/monitors/$(hostname).sh
