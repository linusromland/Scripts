### Variables

# Set Mod Key to Super
set $mod Mod4

# Detect hostname (to load monitor config dynamically)
set $host exec hostname

# Terminal Emulator
set $term ghostyy

# Launcher (set default, override in sway/i3 configs)
set $menu rofi -show drun

# Lock Screen Command (override in sway/i3 configs)
set $lock i3lock
